# ─── ClauseGuard Root .gitignore ───────────────────────────────────────────────

# Environment files (CRITICAL: contains API keys & Supabase secrets)
.env
.env.local
.env.*.local
.env.production
.env.staging

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# Node.js
node_modules/
.next/
out/
build/
.vercel/

# OS files
.DS_Store
Thumbs.db
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
